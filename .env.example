# --- Database (packages/db) ---
# Runtime connection: MUST use a non-superuser, non-table-owner role (e.g. the
# `mhg_app` role created by the row_level_security migration) — Postgres Row-
# Level Security is bypassed for superusers and table owners, so the app
# server connecting as one would silently defeat multi-tenant isolation.
# In production, point this at a pooled endpoint (e.g. Neon pooled/PgBouncer
# transaction mode) using that restricted role's credentials.
DATABASE_URL="postgresql://mhg_app:CHANGE_ME@localhost:5432/mhg_platform"
# Direct (unpooled), privileged connection used only by Prisma Migrate to
# create/alter schema and run the role-creation/RLS migration.
DIRECT_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/mhg_platform"

# --- Auth (packages/auth) ---
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3001"

# --- Rate limiting / cache (Upstash) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observability ---
SENTRY_DSN=""

# --- Document storage (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="mhg-documents-dev"

# --- NOT USED IN PHASE 1 ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
