# --- Database (packages/db) ---
# Pooled connection string used at runtime (e.g. Neon pooled endpoint / PgBouncer transaction mode)
DATABASE_URL="postgresql://user:password@localhost:5432/mhg_platform"
# Direct (unpooled) connection string used by Prisma Migrate
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/mhg_platform"

# --- Auth (packages/auth) ---
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3001"

# --- Rate limiting / cache (Upstash) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observability ---
SENTRY_DSN=""

# --- Document storage (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="mhg-documents-dev"

# --- NOT USED IN PHASE 1 ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
